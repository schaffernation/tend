<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- If you release your own build of Tend, change this to an identifier
       you own, like com.example.tend. -->
  <key>CFBundleIdentifier</key>
  <string>com.schaffernation.tend</string>
  <key>CFBundleName</key>
  <string>Tend</string>
  <key>CFBundleDisplayName</key>
  <string>Tend</string>
  <key>CFBundleExecutable</key>
  <string>Tend</string>
  <!-- The icon: AppIcon in Assets.car, the layered icon that macOS 26 and
       later render as Liquid Glass, with flat renderings for macOS 14 and
       15. AppIcon.icns is the flat fallback. make-icon-assets.sh makes
       both. -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- The version people see. release.sh names the disk image after it. -->
  <key>CFBundleShortVersionString</key>
  <string>0.1</string>
  <!-- The build number. Raise it with every release. -->
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>NSHumanReadableCopyright</key>
  <string>© 2026 SchafferNation LLC</string>
  <!-- Menu bar only: no Dock icon and no main menu. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSAppleEventsUsageDescription</key>
  <string>Tend opens tmux sessions in your terminal app.</string>
  <!-- Sparkle updates. SUFeedURL is the one place the appcast's address
       lives: appcast.sh reads it from here too. Change it if the feed
       moves. -->
  <key>SUFeedURL</key>
  <string>https://tend.schaffernation.com/appcast.xml</string>
  <!-- The public half of the EdDSA key that signs updates. The private half
       is in the maintainer's login keychain, made by Sparkle's generate_keys.
       Released copies trust only updates signed with that key, so never
       change this unless you mean to cut them off from automatic updates.
       See "Build a release" in README.md. -->
  <key>SUPublicEDKey</key>
  <string>usfQFxIL4WF6eDk0lPyW7o6vb3o8Cp6nd/L5Geynyo4=</string>
</dict>
</plist>
